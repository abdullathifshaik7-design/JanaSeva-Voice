# JanaSeva Voice - Production Environment Variables
# Duplicate this file as '.env' and fill in values for production deployment.

# Frontend Configuration
VITE_APP_ENV=production

# Supabase Configuration (Database layer)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Speech-to-Text API Keys (Choose one or more)
# Groq API Key (recommended for Whisper - faster and free tier available)
GROQ_API_KEY=your-groq-api-key-here
# OpenAI API Key (Whisper)
OPENAI_API_KEY=your-openai-api-key-here
# Google Cloud API Key (Google STT as fallback)
GOOGLE_API_KEY=your-google-api-key-here
