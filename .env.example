# JanaSeva Voice - Production Environment Variables
# Duplicate this file as '.env' and fill in values for production deployment.

# Frontend Configuration
VITE_APP_ENV=production
VITE_PHONE_NUMBER=1800-200-5262

# Supabase Configuration (Database layer)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Telephony Provider Configuration (Phone Voice Integration)
PHONE_PROVIDER=twilio # Options: twilio | exotel | generic | mock
PHONE_NUMBER=+9118002005262
PHONE_WEBHOOK_URL=https://your-domain.vercel.app/api/voice
PHONE_WEBHOOK_SECRET=your-webhook-secret-here

# Twilio Telephony Credentials (if PHONE_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Exotel Credentials (if PHONE_PROVIDER=exotel - Indian Telephony)
EXOTEL_SID=your-exotel-sid
EXOTEL_TOKEN=your-exotel-token

# Speech-to-Text & AI Services (Choose one or more)
# Groq API Key (Recommended for fast Whisper STT & LLaMA 3.3 70B dialog)
GROQ_API_KEY=your-groq-api-key-here
# OpenAI API Key (Whisper STT / GPT-4o-mini dialog)
OPENAI_API_KEY=your-openai-api-key-here
# Google Cloud API Key (Google STT & Multilingual Cloud TTS)
GOOGLE_API_KEY=your-google-api-key-here
